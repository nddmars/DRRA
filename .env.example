# Environment variables template for Resilience Forge
#
# SECRETS (DRRA-006): do NOT put real secrets in a committed .env. In production
# deliver every secret from an external secrets manager as a mounted file and
# point DRRA at it with a `{NAME}_FILE` variable, e.g.
#     SECRET_KEY_FILE=/run/secrets/secret_key
#     MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
#     DATABASE_URL_FILE=/run/secrets/database_url
# `{NAME}_FILE` mounts take precedence over the plain `{NAME}` variable and are
# re-read on rotation. Set SECRETS_PROVIDER=file to REQUIRE file mounts (a plain
# env var will not satisfy a secret). When DEBUG=false the app refuses to start
# on any of the development defaults below.

# Secrets provider posture: "env" (env vars or *_FILE mounts) or "file" (*_FILE only)
SECRETS_PROVIDER=env

# API Configuration
DEBUG=false
API_TITLE=Resilience Forge (DRRA)
API_VERSION=0.1.0

# Database — DEV DEFAULT ONLY. Provide a real URL via DATABASE_URL or DATABASE_URL_FILE.
DATABASE_URL=postgresql://drra_admin:CHANGE_ME@localhost:5432/resilience_forge

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO Configuration — provide real keys via *_FILE mounts in production.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_BUCKET_LOGS=immutable-logs
MINIO_BUCKET_ARTIFACTS=forensic-artifacts

# Security — MUST be overridden in production (SECRET_KEY or SECRET_KEY_FILE).
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini AI Integration — provide via GEMINI_API_KEY or GEMINI_API_KEY_FILE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Detection Thresholds
MASS_MODIFICATION_THRESHOLD=0.15
ENTROPY_THRESHOLD=0.85
MTTC_TARGET_SECONDS=60

# VIGIL behavioural model (IsolationForest). Leave VIGIL_MODEL_PATH empty to
# train on a synthetic benign baseline at startup, or point it at a persisted
# model produced by vigil/ml_model.py.
VIGIL_MODEL_PATH=

# Defensibility Index weights (canonical mapping — see backend/services/defensibility.py):
#   DETECTION=alpha (MTTD), ISOLATION=beta (MTTC),
#   RECOVERY=gamma (prevention/APCR), IMMUTABILITY=delta (recovery fidelity)
DI_MAX_SCORE=100
DI_WEIGHT_DETECTION=0.30
DI_WEIGHT_ISOLATION=0.30
DI_WEIGHT_RECOVERY=0.25
DI_WEIGHT_IMMUTABILITY=0.15
